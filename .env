# ==============================================================================
# AGENXA ENVIRONMENT CONFIGURATION
# ==============================================================================
# This file defines the required environment variable schema and structure for
# running the Agenxa Multi-Tenant Platform locally and in production.
# Replace the placeholder values below with your service credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLERK AUTHENTICATION (https://clerk.com/)
# ------------------------------------------------------------------------------
# Publishable key from your Clerk project dashboard (Client-side)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# Secret key for server-side authorization and user sync
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# Clerk redirection routes for agency portal authentication flow
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/agency/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/agency/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ------------------------------------------------------------------------------
# 2. APPLICATION DOMAIN & ROUTING CONFIGURATION
# ------------------------------------------------------------------------------
# Base URL of the web application
NEXT_PUBLIC_URL=http://localhost:3000

# Top-level domain for multi-tenant subdomain resolution
# (e.g. localhost:3000 in development, or yourdomain.com in production)
NEXT_PUBLIC_DOMAIN=localhost:3000

# URL scheme prefix for generated subdomain links (http:// or https://)
NEXT_PUBLIC_SCHEME=http://

# ------------------------------------------------------------------------------
# 3. UPLOADTHING CLOUD MEDIA STORAGE (https://uploadthing.com/)
# ------------------------------------------------------------------------------
# Secret API key for authenticating file upload requests
UPLOADTHING_SECRET=sk_live_your_uploadthing_secret_key_here

# Unique application identifier for your UploadThing app
UPLOADTHING_APP_ID=your_uploadthing_app_id_here

# ------------------------------------------------------------------------------
# 4. STRIPE PAYMENTS & STRIPE CONNECT (https://stripe.com/)
# ------------------------------------------------------------------------------
# Public API key for Stripe Elements and checkout sessions
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Secret API key for server-side Stripe billing and charges
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Signing secret for verifying Stripe webhook events
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
STRIPE_WEBHOOK_SECRET_LIVE=whsec_your_live_stripe_webhook_secret_here

# Client ID for Stripe Connect Express onboarding (starts with ca_...)
NEXT_PUBLIC_STRIPE_CLIENT_ID=ca_your_stripe_connect_client_id_here

# Agenxa subscription product ID for agency membership plans
NEXT_AGENXA_PRODUCT_ID=prod_your_stripe_membership_product_id_here

# Platform fee distributions (numeric percentages and fixed fees)
NEXT_PUBLIC_PLATFORM_SUBSCRIPTION_PERCENT=1
NEXT_PUBLIC_PLATFORM_ONETIME_FEE=2
NEXT_PUBLIC_PLATFORM_AGENCY_PERCENT=10

# ------------------------------------------------------------------------------
# 5. DATABASE CONNECTION (Prisma ORM with MariaDB / MySQL)
# ------------------------------------------------------------------------------
# Primary Prisma connection string:
# Format: mysql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]
DATABASE_URL="mysql://root:password@localhost:3306/agenxa"

# Database connection parameters (used in src/lib/db.ts)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=agenxa

# Environment-specific database endpoints (optional)
PROD_DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"
LOCAL_DATABASE_URL="mysql://root:password@localhost:3306/agenxa"

# ------------------------------------------------------------------------------
# 6. OPTIONAL THIRD-PARTY INTEGRATIONS
# ------------------------------------------------------------------------------
# Builder.io API key (if visual page builder integration is enabled)
NEXT_PUBLIC_BUILDER_API_KEY=your_builder_io_api_key_here
